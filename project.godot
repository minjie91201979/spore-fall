; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Spore Fall"
config/description="2.5D top-down cartoon survival horror - vertical slice (Godot 4.7). 对应《孢城 SPORE FALL》立项方案 §11。"
run/main_scene="res://scenes/ui/Title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icons/icon_1024.png"
boot_splash/bg_color=Color(0.0235294, 0.0392157, 0.0509804, 1)
boot_splash/image="res://assets/icons/icon_512.png"
boot_splash/fullsize=false

[autoload]

GameState="*res://main.gd"
EventBus="*res://core/EventBus.gd"
Career="*res://scripts/systems/CareerStats.gd"
Juice="*res://scripts/fx/Juice.gd"
Sfx="*res://scripts/fx/Sfx.gd"
TouchInput="*res://scripts/ui/TouchInput.gd"
Quality="*res://scripts/systems/QualitySettings.gd"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom_font="res://assets/fonts/system_cjk.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
